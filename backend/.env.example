# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4100
WORKER_HEALTH_PORT=4101
# ── Postgres ──────────────────────────────────────────────────────────────────
# LOCAL (active) — the docker-compose.yml stack; host port 5433 → container 5432.
DATABASE_URL="postgresql://leadsignal:leadsignal_dev_pw@localhost:5433/leadsignal?schema=public"
#
# PROD (reference only). The production API and worker read DATABASE_URL from
# docker-compose.prod.yml, which pins it and overrides anything set here — so
# uncommenting this does not repoint the app. It is for laptop tooling (psql,
# prisma studio, pg_dump) and needs an SSH tunnel, Postgres being loopback-only:
#   ssh -L 5436:127.0.0.1:5436 ubuntu@<server>
# <pw> is POSTGRES_PASSWORD from /opt/leadsignal/env/deploy.env on the server.
# DATABASE_URL="postgresql://leadsignal:<pw>@localhost:5436/leadsignal?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
# LOCAL (active) — docker-compose.yml stack; host port 6380 → container 6379.
REDIS_URL="redis://127.0.0.1:6380"
#
# PROD (reference only — same override rule as DATABASE_URL above), via:
#   ssh -L 6390:127.0.0.1:6390 ubuntu@<server>
# REDIS_URL="redis://127.0.0.1:6390"

APP_URL=http://localhost:4180
ALLOWED_ORIGINS=http://localhost:4180,http://127.0.0.1:4180
LOG_LEVEL=debug

# ─── Crawler identity & politeness ────────────────────────────────────────────
# Must include a +http(s) contact URL — required in production.
CRAWLER_USER_AGENT="LeadSignalBot/1.0 (+https://leadsignal.local/bot; contact: bot@leadsignal.local)"
CRAWLER_CONTACT_URL=https://leadsignal.local/bot
CRAWLER_DEFAULT_DELAY_MS=1500
CRAWLER_MAX_PAGES_PER_HOST=12
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_BYTES=3145728
CRAWLER_MAX_REDIRECTS=4
CRAWLER_CONCURRENCY=6
CRAWLER_RESPECT_ROBOTS=true
# Test-only. Disables the SSRF private-address guard; blocked in production.
CRAWLER_ALLOW_PRIVATE_HOSTS=false

# ─── Optional AI layer (system is fully functional without it) ────────────────
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Anthropic is the fallback for structured AI calls (query parsing, email
# composition) when OpenAI is missing, out of credits, or erroring.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Discovery sources (all optional / free tiers) ────────────────────────────
OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ─── Google Places (optional, PAID — corroboration only) ──────────────────────
# Leave blank to disable; the PLACES_VERIFY step then skips itself and every
# other source keeps working exactly as before.
#
# What it buys, and why it is worth paying for in Gulf/MENA markets where
# OpenStreetMap coverage is thin:
#   • businessStatus — the only source that knows a business has CLOSED. OSM has
#     no concept of closure, so a restaurant that shut in 2023 stays a valid
#     record forever and keeps being emailed.
#   • userRatingCount — a real size/traction proxy no open source provides.
#   • websiteUri — a candidate website, still put through the same identity
#     check as every other source before it is trusted.
#
# SECURITY: this key is billed per call and is used server-side, so it cannot be
# restricted by HTTP referrer. Restrict it in the Google Cloud console to the
# Places API (New) + Geocoding API, and to this server's IP address. Never
# commit it, and rotate it immediately if it is ever pasted somewhere shared.
GOOGLE_MAPS_API_KEY=
# Hard ceiling on billable calls per discovery run — the one guard against a
# grid sweep quietly spending real money.
GOOGLE_PLACES_MAX_CALLS_PER_RUN=200
GOOGLE_PLACES_TIMEOUT_MS=10000

# SMTP mailbox probing — RCPT TO verification of email contacts during list
# hygiene, before any campaign sends. The strongest bounce-rate protection
# available without a vendor; strictly fail-open (only a definitive "mailbox
# does not exist" from the receiving server ever suppresses a contact).
#
# Requirements before enabling: outbound TCP 25 must be open (most clouds block
# it by default — on the prod VPS, test with `nc -w5 gmail-smtp-in.l.google.com 25`),
# and SMTP_PROBE_HELO_DOMAIN should be a real domain whose A record points back
# at this server, ideally with matching reverse DNS. Probing from a host with
# no rDNS gets policy rejections, which the prober correctly ignores — but then
# it verifies nothing.
SMTP_PROBE_ENABLED=false
SMTP_PROBE_HELO_DOMAIN=
SMTP_PROBE_FROM=
SMTP_PROBE_TIMEOUT_MS=12000
SMTP_PROBE_MAX_PER_RUN=150

# Second factor in front of the database backup download in Settings, on top of
# the admin session. That endpoint hands over every lead and every contact in a
# single file. Leave blank to disable the endpoint entirely (it answers 503) —
# an unset value must never be read as "no password needed".
DB_BACKUP_PASSWORD=

# Same Google Cloud key, kept ready for the Gemini work. Nothing reads this yet:
# the AI layer runs on AI_PROVIDER (openai|anthropic). The Generative Language
# API also has to be enabled on the Cloud project before any call succeeds.
GEMINI_API_KEY=

# ─── Discovery limits ─────────────────────────────────────────────────────────
DISCOVERY_MAX_COMPANIES=150
DISCOVERY_MAX_CRAWL_HOSTS=60
DISCOVERY_TIMEOUT_MS=480000
MIN_RESULTS_BEFORE_DISCOVER=5
NOMINATIM_EMAIL=

# ─── AI deep-research layer ───────────────────────────────────────────────────
AI_SEARCH_MODEL=gpt-5.6-terra
AI_FAST_MODEL=gpt-5.6-luna
AI_RUN_BUDGET_USD=0.75
AI_MAX_SEARCH_CALLS=3
AI_MAX_CANDIDATES=36
AI_MAX_CITATION_FETCHES=25
AI_COMPOSE_MAX_LEADS=15
RESEARCH_TIMEOUT_MS=900000

# ─── SaaS Promoter ────────────────────────────────────────────────────────────
# A promote run reads the product's own site and drafts an ideal customer
# profile before it sources anything, so it carries its own budget rather than
# borrowing the research one.
PROMOTER_RUN_BUDGET_USD=1.0
PROMOTER_MAX_PRODUCT_PAGES=8
# Deliberately small: reply rates roughly halve between a 50-recipient campaign
# and a 1,000-recipient one, so the default batch is one a human can read.
PROMOTER_MAX_LEADS_PER_RUN=50

# ─── Bulk outreach caps ───────────────────────────────────────────────────────
# Per-sender ceilings the campaign drain enforces every day, whatever a
# campaign asked for; a mailbox in warm-up sends less still. The recipient cap
# bounds one campaign's list, not its speed — the daily caps do that.
OUTREACH_DAILY_EMAIL_CAP=150
OUTREACH_DAILY_WA_CAP=60
OUTREACH_MAX_RECIPIENTS=2000

# ─── Admin console account ────────────────────────────────────────────────────
# There is no public sign-up. These provision the first account on boot; after
# that the password lives in the database and changing it here has no effect
# unless ADMIN_PASSWORD_RESET=true.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-12-chars
ADMIN_NAME=Administrator
ADMIN_PASSWORD_RESET=false

# Session cookie lifetime and sign-in throttling.
SESSION_COOKIE_NAME=leadsignal_session
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
