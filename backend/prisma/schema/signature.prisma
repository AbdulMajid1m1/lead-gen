/// Reusable sign-offs.
///
/// Kept as structured fields rather than one blob of text so the same signature
/// can render three ways from one row: a styled HTML block for the email's HTML
/// part, a plain-text block for its text part (and for the composer preview),
/// and a stripped-down two-liner for WhatsApp, where a formatted block would
/// just look like noise.

model Signature {
  id String @id @default(cuid())
  /// What it is called in the picker — "Abdul Majid — CTO", "Support", …
  name      String  @unique @db.VarChar(80)
  /// Pre-selected in the composer. At most one signature has this set.
  isDefault Boolean @default(false)

  fullName String  @db.VarChar(120)
  title    String? @db.VarChar(120)
  company  String? @db.VarChar(120)
  /// Stored bare ("deventiatech.com"); the renderers add the scheme.
  website  String? @db.VarChar(200)
  email    String? @db.VarChar(255)
  phone    String? @db.VarChar(40)
  /// One free line under the block — a tagline, a booking link, a disclaimer.
  tagline  String? @db.VarChar(300)
  /// Accent for the rule and the name in the HTML rendering.
  accentColor String @default("#4f39f6") @db.VarChar(9)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mailboxes that use this as their default sign-off.
  accounts EmailAccount[]

  @@index([isDefault])
}

/// A QR-paired WhatsApp device.
///
/// One row per linked device, each with its own Baileys credential folder under
/// .baileys_auth/<id>. Several may be paired at once — `isDefault` picks the one
/// the composer pre-selects, and every thread records which device sent it so a
/// reply is always matched back to the right conversation.
model WhatsAppAccount {
  id String @id @default(cuid())
  /// A human label, set before pairing: "Sales phone", "Personal", …
  label     String  @db.VarChar(80)
  isDefault Boolean @default(false)

  /// Both are learned from WhatsApp at pairing time, not typed by the user.
  phoneNumber String? @unique @db.VarChar(30)
  pushName    String? @db.VarChar(120)

  status    WhatsAppAccountStatus @default(DISCONNECTED)
  lastError String?               @db.VarChar(500)

  /// Follow-up automation, mirroring EmailAccount so one scheduler drives both
  /// channels. Kept per-device because a shared sales phone and a personal one
  /// rarely want the same chase cadence.
  autoFollowUp Boolean @default(true)
  followUpDays Json    @default("[3, 7]")
  maxFollowUps Int     @default(2)

  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  threads OutreachThread[]

  @@index([isDefault])
}
