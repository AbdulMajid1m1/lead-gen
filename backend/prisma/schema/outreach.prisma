/// Outbound email: one or more configured sending mailboxes, threads of sent
/// mail per lead, and every message in each thread — outbound initial pitches
/// and follow-ups, plus inbound replies detected by the IMAP sync.
///
/// Sending and receiving are separable: an account may send through one host
/// (Gmail SMTP, Resend, any SMTP relay) while its replies are read from a
/// different mailbox (e.g. a domain address forwarded into Gmail). Accounts
/// with no IMAP host are send-only — replies are simply not tracked.

enum EmailAccountStatus {
  CONNECTED
  ERROR
  DISABLED
}

enum ThreadStatus {
  AWAITING_REPLY
  REPLIED
  CLOSED
  BOUNCED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum OutreachMessageKind {
  INITIAL
  FOLLOW_UP
  REPLY
  /// A non-delivery report, matched back to the message it killed. Recorded as
  /// a message rather than a flag because a bounce is a real thing the mail
  /// system said to us, and the reason text is what distinguishes "no such
  /// mailbox" from "mailbox full" from "your domain is being rejected".
  BOUNCE
}

/// A connected mailbox used to send outreach and (optionally) poll for replies.
/// Gmail works with an app password (smtp.gmail.com / imap.gmail.com); any SMTP
/// provider fits the same shape. Several may exist at once — `isDefault` picks
/// the one pre-selected in the composer.
model EmailAccount {
  id String @id @default(cuid())
  /// GMAIL | SMTP | RESEND — presets for hosts and auth shape, nothing more.
  provider String @default("GMAIL") @db.VarChar(20)
  /// The From address recipients see. May be a domain alias that differs from
  /// the SMTP login (e.g. sending as you@yourdomain.com through Resend).
  email       String  @unique @db.VarChar(255)
  displayName String? @db.VarChar(120)
  /// Where replies should be directed, when that is not the From address.
  replyTo String? @db.VarChar(255)
  /// Pre-selected in the composer. At most one account has this set.
  isDefault Boolean @default(false)

  smtpHost String  @db.VarChar(255)
  smtpPort Int     @default(465)
  /// SMTP login when it differs from `email` (Resend uses the literal "resend").
  smtpUser String? @db.VarChar(255)
  /// App password / SMTP password / API key. Stored locally for this single-tenant tool.
  authPassword String @db.VarChar(500)

  /// Reply tracking. Null host = send-only account; replies are not polled.
  imapHost     String? @db.VarChar(255)
  imapPort     Int?
  /// IMAP login and password when the inbox is a different mailbox from the
  /// sending identity — e.g. sending as you@yourdomain.com but reading the
  /// Gmail account that the domain forwards into.
  imapUser     String? @db.VarChar(255)
  imapPassword String? @db.VarChar(500)

  status    EmailAccountStatus @default(CONNECTED)
  lastError String?            @db.VarChar(500)

  /// Follow-up automation: send follow-ups automatically when a thread has no
  /// reply after followUpDays[n] days. When off, due follow-ups wait for a click.
  ///
  /// Three chases on a widening gap: a second observation (day 3), one matched
  /// piece of our own work (day 10), then the breakup (day 24). The middle one
  /// is where proof and the only link in the sequence live — the sequence used
  /// to jump straight from "one more observation" to "goodbye" without ever
  /// showing the reader anything we had built.
  autoFollowUp Boolean @default(true)
  followUpDays Json    @default("[3, 7, 14]")
  maxFollowUps Int     @default(3)
  /// Legacy freeform sign-off, kept as the last fallback when no Signature row
  /// is selected anywhere. New setups should use `signatureId` instead.
  signature    String? @db.VarChar(2000)
  /// The sign-off this mailbox uses unless the composer picks another.
  signatureId      String?
  defaultSignature Signature? @relation(fields: [signatureId], references: [id], onDelete: SetNull)

  /// When this mailbox started sending cold outreach, or null once it is past
  /// the ramp. A brand-new sending identity that opens at full volume is the
  /// classic way to land in spam on week one, so the daily cap starts small and
  /// climbs from this date instead of applying in full immediately.
  warmupStartedAt DateTime?

  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  threads OutreachThread[]

  @@index([isDefault])
}

/// One conversation with one lead — email or WhatsApp: the initial pitch, its
/// follow-ups, and any reply. nextFollowUpAt drives the scheduler; a thread is
/// "due" when AWAITING_REPLY and nextFollowUpAt has passed.
model OutreachThread {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// The sending mailbox — null on WhatsApp threads, which go out through a
  /// paired device instead.
  accountId String?
  account   EmailAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The paired device a WhatsApp thread belongs to. SetNull rather than
  /// Cascade: unpairing a phone must not delete the conversations it held.
  waAccountId String?
  waAccount   WhatsAppAccount? @relation(fields: [waAccountId], references: [id], onDelete: SetNull)

  channel OutreachChannel @default(EMAIL)
  /// Email address for EMAIL threads; phone number for WHATSAPP threads.
  recipientEmail String       @db.VarChar(255)
  subject        String       @db.VarChar(255)
  status         ThreadStatus @default(AWAITING_REPLY)

  lastOutboundAt DateTime?
  repliedAt      DateTime?
  followUpsSent  Int       @default(0)
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages OutreachMessage[]

  @@index([leadId])
  @@index([status, nextFollowUpAt])
  @@index([waAccountId, status])
}

model OutreachMessage {
  id       String         @id @default(cuid())
  threadId String
  thread   OutreachThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  direction MessageDirection
  kind      OutreachMessageKind
  subject   String              @db.VarChar(255)
  body      String              @db.VarChar(8000)
  /// RFC 5322 Message-ID — ours on outbound (so replies can be matched by
  /// In-Reply-To/References), theirs on inbound.
  messageId String?             @unique @db.VarChar(255)

  /// The draft this outbound message was composed from, if any.
  draftId String?
  draft   LeadEmailDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  generatedBy ParserUsed?
  sentAt      DateTime?
  receivedAt  DateTime?
  fromAddress String?     @db.VarChar(255)

  /// HARD | SOFT, on BOUNCE messages only.
  ///
  /// The distinction decides what happens to the address: a hard bounce means
  /// the mailbox does not exist and must be suppressed before it is ever sent
  /// to again, while a soft bounce (full mailbox, greylisting, a temporary
  /// outage) says nothing about the address and must not be.
  bounceType String? @db.VarChar(10)
  /// The enhanced SMTP status the report carried, e.g. "5.1.1".
  bounceCode String? @db.VarChar(20)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  /// Powers the rolling bounce rate, which is read on every campaign tick.
  @@index([kind, createdAt])
}

// ─── Bulk campaigns ───────────────────────────────────────────────────────────

enum CampaignStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

/// Per-channel outcome for one lead inside a campaign.
enum CampaignSendState {
  PENDING
  SENT
  SKIPPED // no usable address, already in conversation, or suppressed
  FAILED  // the transport said no
}

/// How a campaign paces itself. DIRECT drains at a fixed paceSeconds from the
/// moment it starts. AUTO spreads sends across a daily hours window under a
/// per-day limit — mailbox providers score bounce/spam partly on burstiness
/// and off-hours volume, so the schedule itself is deliverability protection.
enum CampaignMode {
  DIRECT
  AUTO
}

/// One bulk send: a set of leads, the channels to reach them on, and pacing.
///
/// A campaign never blasts. The worker drains it one lead at a time with
/// `paceSeconds` between sends and a per-account daily cap, because both inbox
/// providers and WhatsApp treat sudden bursts as spam — the fastest way to
/// lose a sending identity is to use it like a cannon.
model OutreachCampaign {
  id   String @id @default(cuid())
  name String @db.VarChar(160)

  /// ["EMAIL"], ["WHATSAPP"] or both.
  channels    Json
  accountId   String? // sending mailbox; null = the default account at send time
  waAccountId String? // sending device;  null = the default device at send time

  status      CampaignStatus @default(RUNNING)
  paceSeconds Int            @default(45)
  lastSentAt  DateTime?

  mode            CampaignMode @default(DIRECT)
  /// AUTO only: max leads reached per local day. Null = the mode's default.
  dailyLimit      Int?
  /// AUTO only: local hours window sends are allowed in (start inclusive,
  /// end exclusive), interpreted with tzOffsetMinutes.
  windowStart     Int          @default(9)
  windowEnd       Int          @default(18)
  /// Minutes east of UTC where the campaign was created (JS -getTimezoneOffset()).
  tzOffsetMinutes Int          @default(0)

  /// Why a campaign stopped itself. Set when the bounce guard pauses one, so
  /// the UI can say what happened rather than showing a campaign that simply
  /// stopped for no stated reason.
  pausedReason String? @db.VarChar(300)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  recipients CampaignRecipient[]

  @@index([status, createdAt])
}

model CampaignRecipient {
  id         String           @id @default(cuid())
  campaignId String
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// State per channel; a channel not in the campaign stays SKIPPED from birth.
  emailState  CampaignSendState @default(PENDING)
  emailDetail String?           @db.VarChar(300)
  waState     CampaignSendState @default(PENDING)
  waDetail    String?           @db.VarChar(300)

  processedAt DateTime?

  @@unique([campaignId, leadId])
  @@index([campaignId, emailState])
  @@index([campaignId, waState])
}
