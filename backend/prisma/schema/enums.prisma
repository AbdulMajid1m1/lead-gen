/// Whether a fetched website actually identifies itself as the company we
/// attached it to. Recorded per domain so a hijacked or mistaken website is
/// visible in the UI instead of silently poisoning outreach.
enum DomainIdentityStatus {
  UNCHECKED // never fetched, or fetched before this check existed
  CONFIRMED // the page names the company, or carries its known phone number
  WEAK      // reachable and not hostile, but never states whose site it is
  REJECTED  // parked, placeholder, shared platform, or an expired-domain takeover
}

