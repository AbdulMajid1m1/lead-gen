/// How much we actually know. Rendered distinctly in the UI so an inference is
/// never mistaken for a fact, and AI output is always visibly AI output.
enum ConfidenceLevel {
  VERIFIED // unambiguous, source-authored proof (vendor header, generator meta)
  DETECTED // strong heuristic match
  INFERRED // derived by our own rules from other facts
  AI_GENERATED // written by the optional LLM layer
}

enum ServiceType {
  WEBSITE_DEV
  CRM_DEV
  MOBILE_APP
  AI_AUTOMATION
  ECOMMERCE_DEV
  SAAS_DEV
  CUSTOM_SOFTWARE
  // A product vertical, not an agency service: leads whose trigger event is
  // "this company just hit HR pain" (first HR hire, hiring at scale). Added so
  // a SaaS like TracefyHR can be sold through the same engine — the outreach
  // email must pitch the platform, not dev services.
  HR_SOFTWARE
  // The generalisation of the line above. A lead found by a SaaS Promoter run
  // is selling one specific PromotedProduct, and which product that is lives on
  // the run and the draft rather than in this enum — so promoting a second
  // product is a row, not a migration.
  SAAS_PRODUCT
}

