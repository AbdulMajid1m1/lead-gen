/// The outreach lifecycle, in the order a lead normally travels it.
///
/// CONTACTED and FOLLOW_UP are both "the ball is in our court, waiting on
/// them"; REPLIED is the one state that means the opposite — a human answered
/// on email or WhatsApp and is waiting on us. It is kept distinct from
/// INTERESTED because a reply is not yet a verdict: "no thanks" is a reply too.
enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  FOLLOW_UP
  REPLIED
  INTERESTED
  CONVERTED
  NOT_INTERESTED
  DISQUALIFIED
  ARCHIVED
  DO_NOT_CONTACT
}

