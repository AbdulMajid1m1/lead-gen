// ─── AI research layer ────────────────────────────────────────────────────────

/// Which field an AI web-search result claims to know.
enum AiClaimField {
  EMAIL
  PHONE
  WHATSAPP
  ADDRESS
  WEBSITE
  DESCRIPTION
}

/// The verification verdict on one AI claim.
///
/// This enum is the heart of the anti-hallucination design: an AI claim is a
/// *pointer to where evidence might be*, never evidence itself. It only becomes
/// a contact once our own crawler observes the same value on a real page.
enum AiClaimStatus {
  UNVERIFIED            // claimed by the model, not yet checked
  CONFIRMED_OWN_SITE    // observed on the company's own site  → contact is VERIFIED
  CONFIRMED_THIRD_PARTY // observed on the cited page          → contact is DETECTED
  CONTRADICTED          // page fetched, value absent or different
  UNCHECKABLE           // citation blocked by robots / bot wall / SSRF guard
  SUPPRESSED            // on the suppression list
}

enum AiCandidateStatus {
  PENDING
  MATCHED_EXISTING      // resolved onto a company we already knew
  CREATED_COMPANY
  REJECTED_UNCITED      // claimed a source URL the search never actually visited
  REJECTED_NO_EXISTENCE // no fetchable site, no map record, nothing confirmed
  REJECTED_EXCLUDED     // matched the brief's exclusions or the suppression list
}

/// Pairing state of a linked WhatsApp device. PAIRING means a QR is on screen
/// and we are waiting for the phone to scan it.
enum WhatsAppAccountStatus {
  CONNECTED
  PAIRING
  DISCONNECTED
  ERROR
}

/// Console access level. VIEWER exists so a future read-only seat does not
/// require a schema change; every provisioned account today is an ADMIN.
enum AdminRole {
  ADMIN
  VIEWER
}

// ─── Client book ──────────────────────────────────────────────────────────────

/// Where a client stands with us today.
///
/// PAST is the plain reading of "previous client": work delivered, nothing
/// running, still absolutely worth a check-in. ARCHIVED is the one state that
/// means "stop surfacing this" — a wound-up company, or a relationship we do
/// not want to revive.
enum ClientStatus {
  ACTIVE
  PAST
  ON_HOLD
  ARCHIVED
}

/// The state of one piece of delivered work. MAINTENANCE is separate from
/// IN_PROGRESS because it changes what the check-in should say: one asks "how
/// is the build going", the other asks "does it still need anything".
enum ClientProjectStatus {
  IN_PROGRESS
  DELIVERED
  MAINTENANCE
  ON_HOLD
  CANCELLED
}
