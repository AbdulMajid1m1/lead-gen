# LeadSignal — infrastructure credentials.
#
# Lives at /opt/leadsignal/env/deploy.env on the server (chmod 600, owned by
# jenkins). bootstrap-server.sh generates this with a random password; this file
# is only here to document the shape.
#
# POSTGRES_PASSWORD is baked into the Postgres data volume the first time the
# container starts. Editing it afterwards does NOT change the database — you
# must also run an ALTER ROLE inside the container, or the API will simply fail
# to authenticate on the next deploy.

POSTGRES_USER=leadsignal
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
POSTGRES_DB=leadsignal
