# LeadSignal — production application secrets.
#
# Lives at /opt/leadsignal/env/backend.env on the server (chmod 600, owned by
# jenkins). Jenkins copies it into each release as backend.env; it is never
# committed and never survives in the repo.
#
# Deliberately NOT set here — the compose file pins these and would override
# anything you put in this file:
#   NODE_ENV, PORT, WORKER_HEALTH_PORT, DATABASE_URL, REDIS_URL, APP_URL,
#   ALLOWED_ORIGINS, CRAWLER_USER_AGENT, CRAWLER_CONTACT_URL,
#   CRAWLER_ALLOW_PRIVATE_HOSTS, CRAWLER_RESPECT_ROBOTS
# Those live in the Jenkinsfile so a change to a port or an allowed origin is a
# reviewable commit rather than an undocumented ssh session.

LOG_LEVEL=info

# ─── Crawler politeness ───────────────────────────────────────────────────────
# Identity is pinned by the Jenkinsfile; only the rate knobs belong here.
CRAWLER_DEFAULT_DELAY_MS=1500
CRAWLER_MAX_PAGES_PER_HOST=12
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_BYTES=3145728
CRAWLER_MAX_REDIRECTS=4
CRAWLER_CONCURRENCY=6

# ─── AI layer (optional — the product works fully without it) ─────────────────
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── AI deep-research layer ───────────────────────────────────────────────────
AI_SEARCH_MODEL=gpt-5.6-terra
AI_FAST_MODEL=gpt-5.6-luna
# Hard ceiling per research run — a bad prompt cannot quietly drain the account.
AI_RUN_BUDGET_USD=0.75
AI_MAX_SEARCH_CALLS=3
AI_MAX_CANDIDATES=36
AI_MAX_CITATION_FETCHES=25
AI_COMPOSE_MAX_LEADS=15
RESEARCH_TIMEOUT_MS=900000

# ─── Discovery sources (free tiers, no registration) ──────────────────────────
OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy asks for a contact address on every request.
NOMINATIM_EMAIL=bot@deventiatech.com

# ─── Discovery limits ─────────────────────────────────────────────────────────
DISCOVERY_MAX_COMPANIES=150
DISCOVERY_MAX_CRAWL_HOSTS=60
DISCOVERY_TIMEOUT_MS=480000
MIN_RESULTS_BEFORE_DISCOVER=5
